+            word,0,head,tgpig.y,args,q,k,v,decay,raw_beta);
+    }
+    for (uint first = 0; first < args.n_rows; first += BLOCK) {
+        FOR_UNROLL (uint i = 0; i < LOADS; ++i) {
+            const uint word = tid + i*THREADS;
+            if (word < WORDS) tile[word] = prefetched[i];
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (first + BLOCK < args.n_rows) {
+            FOR_UNROLL (uint i = 0; i < LOADS; ++i) {
+                const uint word = tid + i*THREADS;
+                if (word < WORDS) prefetched[i] = glm53_kda_stage_word<SGS,BLOCK>(
