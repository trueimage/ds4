+/* Stage a block once per value group. Each lane keeps its original four
+ * key columns, recurrence order and SIMD reduction. Prefetch only immutable
+ * input words; state rows and output elements remain disjoint. */
+template<uint SGS, uint BLOCK>
+static inline float glm53_kda_stage_word(uint index, uint first, uint head, uint group,
+        constant glm53_kda_args &args, device const float *q, device const float *k,
+        device const float *v, device const float *decay, device const float *beta) {
+    constexpr uint STRIDE = 3u*128u + SGS*2u + 4u;
+    const uint token = first + index/STRIDE, column = index%STRIDE;
+    if (token >= args.n_rows) return 0.0f;
+    const ulong base = (ulong)token*args.n_heads*128u + head*128u;
+    if (column < 128u) return q[base + column];
+    if (column < 256u) return k[base + column - 128u];
+    if (column < 384u) return decay[base + column - 256u];
+    if (column < 384u + SGS*2u) return v[base + group*SGS*2u + column - 384u];
+    return beta[(ulong)token*args.n_heads + head];
+}
