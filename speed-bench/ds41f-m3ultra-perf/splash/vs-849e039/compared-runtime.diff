+static DS4_MAYBE_UNUSED bool ds41_graph_step_batch(ds41_gpu_graph *const *graphs, const int *tokens, int count,
+                                   uint32_t prefill_rows,
+                                   const ds4_model *model, const ds4_weights *weights) {
